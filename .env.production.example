# ==============================================================================
# Folio OS - Production Environment Variables (.env.production)
# ==============================================================================
# Instructions:
# 1. Duplicate this file as .env.production.local or set in your deployment
#    platform (e.g. Vercel Project Settings > Environment Variables).
# 2. Never commit actual secret keys (especially SUPABASE_SERVICE_ROLE_KEY) to git.
# 3. Ensure NEXT_PUBLIC_DEMO_MODE is set to 'false' in production.
# ==============================================================================

# Supabase Project URL (Production instance in Mumbai ap-south-1)
NEXT_PUBLIC_SUPABASE_URL=https://<your-production-project-ref>.supabase.co

# Supabase Public Anon Key (Browser-safe, respects Postgres Row-Level Security)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Supabase Service Role Key (SERVER-ONLY: strictly used by server actions and admin scripts)
# DO NOT prefix with NEXT_PUBLIC_!
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Production Safety Flag:
# Setting to 'false' completely disables demo credentials, persona switchers,
# and blocks test/mock data seeding.
NEXT_PUBLIC_DEMO_MODE=false

# Canonical Site URL for Auth Redirects and Magic Links
NEXT_PUBLIC_SITE_URL=https://folio.fitt-iitd.in
